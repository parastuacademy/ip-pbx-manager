; ip-pbx-manager — AMI (Asterisk Manager Interface).
; Rendered by entrypoint.sh from this template; only reachable on the
; internal docker network (port 5038 is NOT published).

[general]
enabled = yes
webenabled = no
port = 5038
bindaddr = 0.0.0.0
displayconnects = no

[panel]
secret = __AMI_PASSWORD__
deny = 0.0.0.0/0.0.0.0
permit = 0.0.0.0/0.0.0.0
read = all
write = all
